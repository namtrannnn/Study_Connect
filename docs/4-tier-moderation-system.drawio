        <mxCell id="t3_gemini" value="🧠 Gemini AI Analysis&#xa;─────────────&#xa;• Gửi Text + Ảnh (URL)&#xa;• Phân tích 6 tiêu chí:&#xa;  sexual, violence,&#xa;  harassment, hate,&#xa;  scam, spam&#xa;• Trả về % rủi ro" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ddd6fe;strokeColor=#7c3aed;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;" vertex="1" parent="1">
